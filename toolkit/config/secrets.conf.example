# MZD Toolkit secrets - copy to secrets.conf and fill in.
# v4.8.0: secrets.conf staat in $SETTINGS_DIR (= $USB_MOUNT/mzd-data/config)
# on the USB root. secrets.conf itself is in .gitignore and NEVER goes into
# git of release assets (build-release.sh verify faalt bij hit).
#
# MZD_SSH_PASSWORD: password for the LOCAL sshd on port 22 (cmu user).
#   Empty/absent = pubkey-only (v4.7.5 behaviour, -i ssh/id_mzd).
#   Test phase: put your short password here.
#   NOTE: port 22 is exposed on the car's WiFi network - choose something
#   that cannot be guessed (min. ~10 chars, or consciously accept the risk).
MZD_SSH_PASSWORD=""

# WIFI_SSID / WIFI_PASSWORD may also be overridden here (settings.conf is default):
# WIFI_SSID="YOUR_HOTSPOT_SSID"
# WIFI_PASSWORD="OPEN"   # OPEN = open network, no password
# MZD_PSK="..."          # wifi psk - passed via env, never as argv
